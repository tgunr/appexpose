{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AppExpose",
            "type": "process",
            "command": "xcodebuild",
            "args": [
                "-project",
                "AppExposeS.xcodeproj",
                "-scheme",
                "AppExposeS",
                "-configuration",
                "Debug",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Copy Frameworks",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/DerivedData/AppExposeS/Build/Products/Debug/AppExposeS.app/Contents/Frameworks\" && cp -R \"${workspaceFolder}/DerivedData/AppExposeS/Build/Products/Debug/\"*.framework \"${workspaceFolder}/DerivedData/AppExposeS/Build/Products/Debug/AppExposeS.app/Contents/Frameworks/\"",
            "dependsOn": ["Build AppExpose"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "sweetpad: launch",
            "type": "process",
            "command": "open",
            "args": [
                "./DerivedData/AppExposeS/Build/Products/Debug/AppExposeS.app"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": [
                "Copy Frameworks"
            ]
        }
    ]
}